# Telegram Bot Token
# Copy this file to .env and replace the placeholder with your own token.
# Get a token from @BotFather on Telegram.
BOT_TOKEN=your_telegram_bot_token_here

# Optional settings
DATABASE_URL=sqlite:///./bot.db
DEBUG=False

# Telegram Mini App URL.
# Use http://localhost:5000 for local browser testing.
# Telegram requires a public HTTPS URL, for example from ngrok, cloudflared, or your hosting.
WEB_APP_URL=http://localhost:5000
